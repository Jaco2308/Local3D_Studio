# ==============================================================================
# Local3D Studio Production Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 3D Compute Worker Configuration (Standalone vs LAN Wi-Fi Offloading)
# ------------------------------------------------------------------------------
# Host to bind the worker service (0.0.0.0 makes it accessible over local Wi-Fi)
WORKER_HOST=0.0.0.0
WORKER_PORT=8000

# URL used by the MCP Server to communicate with the 3D Compute Worker:
# - Standalone Local Mode (Everything running on the same machine):
#   WORKER_URL=http://127.0.0.1:8000
# - Wi-Fi LAN Remote Offloading (e.g. MacBook Air client -> Desktop PC compute):
#   WORKER_URL=http://192.168.1.50:8000
WORKER_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Dynamic Hardware Tiering & Auto-Scaling Performance Profiles
# ------------------------------------------------------------------------------
# Options:
# - AUTO (default): Automatically detects system RAM (psutil) and GPU VRAM (CUDA/ROCm/MPS),
#                   selecting the highest tier supported by the machine:
#
#   * TIER_1_ECO:     Mac 16GB Unified / PC VRAM <= 8GB or RAM <= 16GB
#                     Hunyuan3D-2mini @ 256p, 18 steps, 50k triangles, STRICT_DISK_UNLOAD
#
#   * TIER_2_BALANCED: Mac 24-36GB / PC 10-12GB VRAM & 32GB RAM
#                     Hunyuan3D-2mini @ 320p, 25 steps, 65k triangles, SINGLE_RAM_CACHE
#
#   * TIER_3_PRO_64GB: >= 48GB System RAM + >= 15GB VRAM (e.g. Ryzen 9800X3D + 64GB DDR5 + RX 9070 XT 16GB)
#                     Hunyuan3D-2 Full (1.1B) @ 384p, 30 steps, 90k triangles, voxel=0.0042, DDR5_HOT_SWAP
#
#   * TIER_4_ULTRA:   PC with VRAM >= 22GB & RAM >= 64GB, or Mac >= 64GB Unified
#                     Hunyuan3D-2 Full (1.1B) @ 512p, 35 steps, 120k triangles, VRAM_PINNED
#
# Manual override options:
# FORCE_TIER=AUTO
# FORCE_TIER=TIER_1
# FORCE_TIER=TIER_2
# FORCE_TIER=TIER_3
# FORCE_TIER=TIER_4
FORCE_TIER=AUTO

# ------------------------------------------------------------------------------
# 3. Blender Path (Leave empty to auto-detect, or provide exact path)
# ------------------------------------------------------------------------------
# macOS example:   /Applications/Blender.app/Contents/MacOS/Blender
# Windows example: C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Linux example:   /usr/bin/blender
BLENDER_PATH=

# ------------------------------------------------------------------------------
# 4. Optional Manual Parameter Overrides (Leave empty to follow active Tier)
# ------------------------------------------------------------------------------
# MODEL_TIER=mini|full
# OCTREE_RESOLUTION=256|320|384|512
# INFERENCE_STEPS=18|25|30|35
# BLENDER_VOXEL_SIZE=0.0085|0.0060|0.0042|0.0035
# TARGET_TRIANGLES=50000|65000|90000|120000

# ------------------------------------------------------------------------------
# 5. Optional Hugging Face Token (for high-speed cloud space fallback)
# ------------------------------------------------------------------------------
HF_TOKEN=
